# توكن بوت تليجرام (من @BotFather) — املأ القيمة الحقيقية محليًا فقط
BOT_TOKEN=

# معرّفات المالك (اختياري، مفصولة بمسافة أو فاصلة)
OWNER_IDS=

# المنطقة الزمنية والتوقيت
TIMEZONE=Africa/Cairo
DEFAULT_CITY=Cairo
DEFAULT_COUNTRY=Egypt

# القارئ الافتراضي: maher | husary | minshawi | abdulbasit | sudais | shuraym | ghamdi | ajamy
DEFAULT_RECITER=maher

# ساعات الإرسال اليومي (توقيت TIMEZONE)
DAILY_AYAH_HOUR=8
DAILY_HADITH_HOUR=10
DAILY_ADHKAR_HOUR=18

# مسارات اختيارية (افتراضيًا داخل مجلد المشروع)
# DATA_DIR=
# DB_PATH=
# LOG_DIR=

# رابط واجهة الويب إن أردت لاحقًا (اختياري)
PUBLIC_URL=https://example.com/webapp

# تشغيل/إيقاف مولّد الفيديو
VIDEO_ENABLED=1

# زمن مهلة الاتصال بالواجهات (ثوانٍ)
HTTP_TIMEOUT=15
